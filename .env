# Public site URL, used to build absolute Open Graph / Twitter image URLs.
# Set it to your deployed domain (no trailing slash), e.g. https://kabartinaa.vercel.app
VITE_SITE_URL=

# Optional: a form endpoint (Formspree, Web3Forms, Getform, your own API...).
# When empty, the contact form opens the visitor's email app (mailto) instead.
VITE_CONTACT_ENDPOINT=
